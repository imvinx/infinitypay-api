# ==============================================================================
# InfinityPay API - Environment Variables Template
# Copy this file to .env and fill in your production/staging secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# Base API URL (used for generating absolute payment & checkout links)
# In local dev: http://localhost:3000
# In Vercel production: https://YOUR-VERCEL-PROJECT.vercel.app
API_BASE_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma compatible)
# Supports Supabase, Neon, AWS RDS, Heroku Postgres, or local PostgreSQL
# Example: postgresql://postgres:password@localhost:5432/infinitypay?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# InfinityPay API Master Secret (used for signing and system-level operations)
# Generate a 32+ character random string: openssl rand -hex 32
INFINITYPAY_API_SECRET=your_32_character_hex_master_secret_here

# AES-256-GCM Encryption Key (strictly 32 bytes / 64 hex characters)
# Used to encrypt sensitive integration secrets at rest (e.g., app passwords, oauth tokens)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google / Gmail API Credentials (for server-side mailbox transaction synchronization)
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=https://infinitypay-api.vercel.app/api/auth/gmail/callback

# Vercel Cron Secret (protects /api/cron/sync from unauthorized requests)
CRON_SECRET=your_secure_cron_secret_token_here

# CORS Allowed Origins (comma-separated origins or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://infinitypay-api.vercel.app

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=60
